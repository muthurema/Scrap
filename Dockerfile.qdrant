FROM qdrant/qdrant:v1.13.3

# All knobs passed via env vars (Railway service Variables).
# Defaults chosen to minimise RAM on the 2-4GB Railway tier:
#   - ON_DISK_PAYLOAD=true → payload mmap'd from disk instead of held in RAM
#   - MEMMAP_THRESHOLD_KB=20480 → collections above ~20MB switch to mmap
#   - DEFAULT_SEGMENT_NUMBER=2 → fewer in-flight segments = lower RSS
#   - STORAGE_PATH=/qdrant/storage → matches the Railway Volume mount path
ENV QDRANT__LOG_LEVEL=INFO \
    QDRANT__STORAGE__ON_DISK_PAYLOAD=true \
    QDRANT__STORAGE__MEMMAP_THRESHOLD_KB=20480 \
    QDRANT__STORAGE__OPTIMIZERS__DEFAULT_SEGMENT_NUMBER=2 \
    QDRANT__STORAGE__STORAGE_PATH=/qdrant/storage

# IMPORTANT — Railway-specific port handling.
#
# Railway assigns a dynamic ${PORT} at container start AND directs all
# health checks + internal-network traffic to that port. Qdrant won't
# pick it up automatically (its default is 6333), so the healthcheck
# fails with "service unavailable" and the deploy is rolled back.
#
# Fix: a tiny shell entrypoint that exports QDRANT__SERVICE__HTTP_PORT
# from $PORT at runtime, then exec's the real qdrant binary. Falls back
# to 6333 when run locally (no Railway env).
#
# Also: do NOT declare a Docker VOLUME — Railway rejects it. Attach a
# Railway Volume in the dashboard at mount path /qdrant/storage instead.
ENTRYPOINT ["sh", "-c", "export QDRANT__SERVICE__HTTP_PORT=${PORT:-6333} && exec /qdrant/qdrant"]
